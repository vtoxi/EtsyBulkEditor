{
  "manifest_version": 3,
  "name": "Etsy Bulk Editor — Bulk Listing Editor",
  "short_name": "EtsyBulk",
  "version": "1.0.0",
  "description": "Bulk-edit Etsy listings by copying tags, previewing price changes, or exporting selected listing data to CSV.",
  "author": "EtsyBulk",
  "homepage_url": "https://github.com/vtoxi/EtsyBulkEditor",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.etsy.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/your/*"],
      "js": ["src/content-scripts/bulk-editor.js"],
      "css": ["src/content-scripts/bulk-editor.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Etsy Bulk Editor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
